{
  "id": null,
  "title": "Northfield status",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Health",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "northfield_health", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Requests",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "northfield_requests_total", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Uptime seconds",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "northfield_uptime_seconds", "refId": "A" }]
    }
  ]
}
